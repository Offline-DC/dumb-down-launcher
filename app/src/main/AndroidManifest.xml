<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.offlineinc.dumbdownlauncher">

    <uses-permission android:name="android.permission.READ_CONTACTS"/>
    <uses-permission android:name="android.permission.WRITE_CONTACTS"/>
    <!-- Nightly call-log pruning: CallLogCleanupWorker keeps the newest 25
         rows in calllog.db so the system DB doesn't bloat on low-storage
         devices (TCL Flip Go etc.) and the dialer / launcher stay snappy.
         READ is needed to look up the cutoff date (the 25th-newest row)
         before WRITE deletes everything older. Both perms are self-granted
         at runtime via `su pm grant` from the worker, mirroring the
         PhoneNumberReader / OpenBubbles patterns. -->
    <uses-permission android:name="android.permission.READ_CALL_LOG"/>
    <uses-permission android:name="android.permission.WRITE_CALL_LOG"/>
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION"/>
    <!-- Wi-Fi scanning for BeaconDB geolocation. Works on phones that have
         no Network Location Provider (e.g. MediaTek/TCL builds without Play
         Services) by sending nearby BSSIDs to a Mozilla-style API. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE"/>
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"/>
    <!-- Lets update downloads hide the system DownloadManager notification
         (which only shows "time left") in favor of the launcher's own
         progress notification (bar + MB/%). See DownloadAndInstallReceiver. -->
    <uses-permission android:name="android.permission.DOWNLOAD_WITHOUT_NOTIFICATION"/>
    <!-- Diagnostic logging (runtime opt-in via long-press on "weather" in
         All Apps). RebootLoggingService runs as a foreground service so
         the rolling 24-hour logcat tail survives doze/idle — a service
         that the OS kills the moment the screen goes off would miss the
         exact window we need. The privileged `logcat` read is executed
         via `su -c` (root via Magisk) so READ_LOGS isn't required on the
         app itself. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE"/>
    <uses-permission android:name="android.permission.READ_PHONE_NUMBERS"/>
    <!-- Required by TelephonyManager.sendUssdRequest in the USSD fallback path
         inside PhoneNumberReader for devices where Settings.Secure.device_phone_number
         was never written by automated_configuration.sh. PhoneNumberReader
         self-grants this at runtime via `su -c "pm grant …"` if the user hasn't
         granted it through the normal runtime-permission flow. -->
    <uses-permission android:name="android.permission.CALL_PHONE"/>
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- Battery diagnostics (gated by BuildConfig.DIAGNOSTICS_ENABLED).
         DiagnosticsService runs as a foreground service so the per-minute
         battery sampling loop and broadcast receivers survive doze/idle. The
         privileged dumpsys/logcat snapshots are executed via `su -c` (root
         via Magisk) rather than directly, so READ_LOGS / BATTERY_STATS /
         DUMP / PACKAGE_USAGE_STATS aren't required on the app itself. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Read pairing data from contact-sync app (legacy migration) -->
    <uses-permission android:name="com.offlineinc.dumbcontactsync.DEVICE_LINK_READ"/>

    <!-- Signature-level permission: only apps signed with the same key can read pairing data -->
    <permission
        android:name="com.offlineinc.dumbdownlauncher.DEVICE_LINK_READ"
        android:protectionLevel="signature" />

    <application
        android:name=".DumbDownApp"
        android:allowBackup="true"
        android:persistent="true"
        android:label="Dumb Launcher"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.DumbDownLauncher">

        <activity
            android:name=".MainAppsGridActivity"
            android:exported="false" />

        <activity
            android:name=".AllAppsActivity"
            android:exported="false" />

        <activity
            android:name=".WebViewActivity"
            android:exported="false"
            android:theme="@android:style/Theme.NoTitleBar.Fullscreen" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:excludeFromRecents="true">

            <!-- Makes it a HOME launcher -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

            <!-- Makes it runnable from Android Studio + visible in app list -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <activity
            android:name=".notifications.ui.NotificationsActivity"
            android:exported="false" />

        <!-- In-app Google Messages messenger (replaces the old
             "open messages.google.com/web in Chrome" path for the
             "android" smart-txt platform). Phase A backs this with mock
             data; Phase B+ wires the real Google Messages protocol.
             singleTask + clearTaskOnLaunch so re-launching from the home
             grid always lands on the room list rather than wherever the
             user left off — matches the muscle memory the launcher's
             other apps already have.

             Distinct taskAffinity puts this messenger in its OWN task,
             separate from the home/grid task. Without it, the messenger
             shares the default (package) affinity with the grid, so Back
             could walk into stale launcher state instead of returning to
             the grid. Its own task keeps the app self-contained: home goes
             home, and Back from here returns to wherever it was launched
             (the grid). -->
        <activity
            android:name=".messenger.MessengerActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity="com.offlineinc.dumbdownlauncher.task.gmessages"
            android:clearTaskOnLaunch="true"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.DumbDownLauncher" />

        <!-- One-time "Google Messages is built in now" announcement, shown the
             first time android smart txt is opened. singleTop so a double launch
             (flip-phone keys can fire twice) doesn't stack two copies. -->
        <activity
            android:name=".messenger.GoogleMessagesAnnouncementActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:theme="@style/Theme.DumbDownLauncher" />

        <!-- Receives Google-account cookies from the companion phone over the
             Type Sync relay (Messages-for-web sign-in). -->
        <activity
            android:name=".messenger.GoogleCookieReceiveActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:theme="@style/Theme.DumbDownLauncher" />

        <activity
            android:name=".update.WifiThenUpdateActivity"
            android:exported="false"
            android:launchMode="singleInstance"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <activity
            android:name=".contactsync.ContactSyncActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:noHistory="true"
            android:theme="@style/Theme.DumbDownLauncher" />

        <activity
            android:name=".quack.QuackActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:noHistory="true"
            android:theme="@style/Theme.DumbDownLauncher" />

        <!-- dumb map (beta): no noHistory so the route/selection survives
             leaving and returning via the navigation notification -->
        <activity
            android:name=".MapsActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:theme="@style/Theme.DumbDownLauncher" />

        <activity
            android:name=".snake.SnakeActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:theme="@style/Theme.DumbDownLauncher" />

        <activity
            android:name=".weather.WeatherActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:noHistory="true"
            android:theme="@style/Theme.DumbDownLauncher" />

        <activity
            android:name=".storage.FreeUpSpaceActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:noHistory="true"
            android:theme="@style/Theme.DumbDownLauncher" />

        <!-- Diagnostics hidden screen. Opened by long-pressing the "quack"
             row in All Apps. Battery-analysis toggle + session controls,
             rolling-ADB-logs toggle (RebootLoggingService), and submit-logs
             upload. Gated by BuildConfig.DIAGNOSTICS_ENABLED at runtime —
             the diag beta build sets it true. See
             battery-diagnostics-plan.md for the full investigation plan. -->
        <activity
            android:name=".diagnostics.DiagnosticsActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:noHistory="true"
            android:theme="@style/Theme.DumbDownLauncher" />

        <!-- Battery diagnostics foreground service. Per-minute battery
             sampling, broadcast receivers for screen/power/doze, and an
             hourly privileged dumpsys snapshot scheduler. Runs only when
             the user has opted in via DiagnosticsActivity. -->
        <service
            android:name=".diagnostics.DiagnosticsService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Headless trampoline for the "add wifi 2 save on data" nudge.
             Tapping the notification (from the shade or the in-app
             Notifications page) lands here; it cancels the notification
             and forwards to the system Wi-Fi settings activity, then
             finishes immediately with no visible UI.

             Translucent theme + excludeFromRecents + noHistory keep the
             trampoline invisible: no flash, no Recents entry, no back-
             stack residue. -->
        <activity
            android:name=".wifinudge.WifiNudgeTapActivity"
            android:exported="false"
            android:launchMode="singleInstance"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <service
            android:name=".MouseAccessibilityService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/mouse_service_config" />
        </service>

        <!-- WebKeyboardService removed — relay moved into MouseAccessibilityService -->

        <!--
            Manages the Presentation window on the 128×128 cover display.
            Started from DumbDownApp — no foreground notification needed since
            the launcher process is protected by the HOME intent category.
        -->
        <service
            android:name=".coverdisplay.CoverDisplayService"
            android:exported="false" />

        <!-- Diagnostic logging foreground service. Owns the rolling
             24-hour logcat tail (size-rotated ring under
             <filesDir>/diag/rolling-logcat/). Runs only when the user
             has flipped the runtime opt-in via the long-press-on-
             weather toggle in AllAppsActivity. -->
        <service
            android:name=".diagnostics.RebootLoggingService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <service
            android:name=".notifications.DumbNotificationListenerService"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
            android:exported="false">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <receiver
            android:name=".update.DownloadAndInstallReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.offlineinc.dumbdownlauncher.action.DOWNLOAD_APK" />
                <action android:name="android.intent.action.DOWNLOAD_COMPLETE" />
            </intent-filter>
        </receiver>

        <!-- Nightly 4 AM automatic update installer. When the device is on
             Wi-Fi and battery >= 40%, downloads and SILENTLY installs (via
             root pm install) any newer Dumb Down Launcher / Smart Txt release.
             Re-armed on every boot from DumbDownApp.onCreate, same as the
             quack / wifi-nudge alarms, so a reboot near 4 AM self-heals. -->
        <receiver
            android:name=".update.AutoUpdateAlarmReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.offlineinc.dumbdownlauncher.AUTO_UPDATE" />
            </intent-filter>
        </receiver>

        <!-- Manual adb trigger for the nightly auto-updater. Fires the same
             check-conditions → download → silent-install path immediately,
             bypassing the 4 AM schedule (Wi-Fi + battery gate still applies).
             Same exposure rationale as the other RUN_* triggers — worst case
             is installing an update the user would get at 4 AM anyway. -->
        <receiver
            android:name=".update.AutoUpdateTriggerReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.offlineinc.dumbdownlauncher.RUN_AUTO_UPDATE" />
            </intent-filter>
        </receiver>

        <!-- Receives star-key long-press broadcast from FlipMouse daemon -->
        <receiver
            android:name=".TypeSyncToggleReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.offlineinc.dumbdownlauncher.TOGGLE_TYPESYNC" />
            </intent-filter>
        </receiver>

        <!-- Monday 9am Eastern quack reminder alarm -->
        <receiver
            android:name=".quack.QuackMondayAlarmReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.offlineinc.dumbdownlauncher.QUACK_MONDAY" />
            </intent-filter>
        </receiver>

        <!-- 2nd Tuesday / 4th Sunday "add wifi 2 save on data" nudge alarm.
             Re-armed on every boot from DumbDownApp.onCreate, so
             AlarmManager losing the schedule on reboot or app update
             self-heals on the next launcher process start.
             Tap handling lives in WifiNudgeTapActivity, not here — see
             that class for the Android 10+ background-activity-start
             rationale. -->
        <receiver
            android:name=".wifinudge.WifiNudgeAlarmReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.offlineinc.dumbdownlauncher.WIFI_NUDGE" />
            </intent-filter>
        </receiver>

        <!-- Manual trigger for the call-log cleanup worker. Lets the
             deletion logic be exercised on demand from adb, bypassing
             WorkManager / JobScheduler entirely. Exported so `am broadcast`
             from the shell uid can reach it; no permission required because
             the worst case is the user's own retention policy running early. -->
        <receiver
            android:name=".calllog.CallLogCleanupTriggerReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.offlineinc.dumbdownlauncher.RUN_CALL_LOG_CLEANUP" />
            </intent-filter>
        </receiver>

        <!-- Manual trigger for the OpenBubbles weekly attachment-cleanup
             worker. Same rationale as the call-log trigger above —
             worst-case effect is the same wipe the worker performs at 2 AM. -->
        <receiver
            android:name=".openbubbles.OpenBubblesAttachmentCleanupTriggerReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.offlineinc.dumbdownlauncher.RUN_OB_ATTACHMENT_CLEANUP" />
            </intent-filter>
        </receiver>

        <!-- Manual trigger for the WhatsApp nightly attachment-cleanup
             worker. Pairs with scripts/whatsapp_probe.sh: run the probe
             to snapshot pre-cleanup state, fire this broadcast, run the
             probe again to confirm the file count and disk-usage numbers
             dropped as expected. Same exposure rationale as the OB and
             call-log triggers — worst-case effect is running the same
             nightly wipe the worker performs at 4 AM. -->
        <receiver
            android:name=".whatsapp.WhatsAppAttachmentCleanupTriggerReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.offlineinc.dumbdownlauncher.RUN_WA_ATTACHMENT_CLEANUP" />
            </intent-filter>
        </receiver>

        <!-- Manual triggers for the StorageCleanupOps paths exposed from
             the "free up space" UI. Lets each cleanup be fired on demand
             from adb for testing without going through the screen. Same
             exposure rationale as the other triggers — worst case is
             performing a cleanup the user would have run from the UI
             anyway. -->
        <receiver
            android:name=".storage.StorageCleanupTriggerReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.offlineinc.dumbdownlauncher.RUN_CLEAR_ANTENNAPOD" />
                <action android:name="com.offlineinc.dumbdownlauncher.RUN_CLEAR_SPOTIFY_OFFLINE" />
                <action android:name="com.offlineinc.dumbdownlauncher.RUN_CLEAR_APPLE_MUSIC_OFFLINE" />
                <action android:name="com.offlineinc.dumbdownlauncher.RUN_CLEAR_WHATSAPP_MEDIA" />
                <action android:name="com.offlineinc.dumbdownlauncher.RUN_CLEAR_OPENBUBBLES_ATTACHMENTS" />
            </intent-filter>
        </receiver>

        <!-- Manual triggers for the "add wifi 2 save on data" nudge. Lets
             the four code paths (scheduled alarm, boot-time check, force
             post, cancel) be exercised on demand from adb, bypassing the
             real 2nd-Tuesday / 4th-Sunday cadence. See
             WifiNudgeTriggerReceiver for the per-action contracts.
             Worst-case effect of an unsolicited fire is one dismissable
             notification. -->
        <receiver
            android:name=".wifinudge.WifiNudgeTriggerReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.offlineinc.dumbdownlauncher.RUN_WIFI_NUDGE_ALARM" />
                <action android:name="com.offlineinc.dumbdownlauncher.RUN_WIFI_NUDGE_BOOT" />
                <action android:name="com.offlineinc.dumbdownlauncher.FORCE_POST_WIFI_NUDGE" />
                <action android:name="com.offlineinc.dumbdownlauncher.CANCEL_WIFI_NUDGE" />
            </intent-filter>
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_provider_paths" />
        </provider>

        <!-- Exposes device-link pairing state to the contact-sync app.
             Both apps are signed with the same key on the TCL Flip Go. -->
        <provider
            android:name=".pairing.DeviceLinkProvider"
            android:authorities="com.offlineinc.dumbdownlauncher.devicelink"
            android:exported="true"
            android:readPermission="com.offlineinc.dumbdownlauncher.DEVICE_LINK_READ" />

        <!-- WorkManager's foreground-service host ships with no
             foregroundServiceType, so when AutoUpdateWorker runs as a foreground
             job and passes FOREGROUND_SERVICE_TYPE_DATA_SYNC, startForeground
             rejects it ("type 0x1 is not a subset of 0x0"). Merge the dataSync
             type onto the library's service so the typed ForegroundInfo is
             accepted (and is required at all on targetSdk 34+). -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />

    </application>

    <queries>
        <package android:name="com.whatsapp" />
        <package android:name="com.ubercab" />
        <package android:name="com.android.chrome" />

        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>
</manifest>
